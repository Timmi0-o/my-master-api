{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "src/modules/.*/test/e2e/.*\\.e2e-spec\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@tokenizer/s3$": "<rootDir>/src/modules/shared/test/support/mocks/tokenizer-s3.mock.ts",
    "^file-type$": "<rootDir>/src/modules/shared/test/support/mocks/file-type.mock.ts",
    "^@modules/(.*)$": "<rootDir>/src/modules/$1",
    "^@shared/(.*)$": "<rootDir>/src/modules/shared/$1",
    "^@test-support/(.*)$": "<rootDir>/src/modules/shared/test/support/$1",
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "testEnvironment": "node"
}
