model User {
  id String @id @default(uuid())

  email    String  @map("email")
  phone    String? @map("phone")
  username String  @map("username")

  roleId String @map("role_id")
  status Status @default(PENDING) @map("status")

  passwordHash String @map("password_hash")

  emailVerifiedAt DateTime? @map("email_verified_at")

  name       String  @map("name")
  surname    String  @map("surname")
  patronymic String? @map("patronymic")

  language Language @default(RU) @map("language")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  masterProfile MasterProfile?
  userProfile   UserProfile?

  sessions                Session[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  clientAppointments      Appointment[]            @relation("ClientAppointments")
  clientAppointmentChats  AppointmentChat[]        @relation("ClientAppointmentChats")
  appointmentChatMessages AppointmentChatMessage[] @relation("AppointmentChatMessages")
  masterServiceReviews           MasterServiceReview[]
  masterServiceReviewReactions   MasterServiceReviewReaction[]
  masterSubscriptions            MasterSubscription[]
  favoriteMasterServices         FavoriteMasterService[]
  userServiceInteractions        UserServiceInteraction[]
  userBlocksCreated              UserBlock[]             @relation("UserBlocksCreated")
  userBlocksReceived             UserBlock[]             @relation("UserBlocksReceived")
  userPersonalNotesOwned         UserPersonalNote[]      @relation("UserPersonalNotesOwned")
  userPersonalNotesReferenced    UserPersonalNote[]      @relation("UserPersonalNotesReferenced")
  bugReports                     BugReport[]
  webPushSubscriptions           WebPushSubscription[]
  notifications                  Notification[] @relation("UserNotifications")
  actedNotifications             Notification[] @relation("UserActedNotifications")
  appointmentChatUnreadReminders AppointmentChatUnreadReminder[] @relation("AppointmentChatUnreadReminders")

  @@unique([email])
  @@unique([phone])
  @@unique([username])
  @@index([email, phone, username])
  @@index([roleId])
  @@map("Users")
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
}

enum Language {
  RU
  EN
  ES
  ZH
  AR
  FR
  DE
  PT
  JA
  HI
}
