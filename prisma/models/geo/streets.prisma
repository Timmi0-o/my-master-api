model Street {
  id                 String                                @id @default(uuid())
  countryId          String                                @map("country_id")
  regionId           String                                @map("region_id")
  localityId         String?                               @map("locality_id")
  localityDistrictId String?                               @map("locality_district_id")
  settlementId       String?                               @map("settlement_id")
  garObjectId        BigInt                                @unique @map("gar_object_id")
  garObjectGuid      String                                @unique @map("gar_object_guid")
  garLevel           Int                                   @map("gar_level")
  garTypeName        String?                               @map("gar_type_name")
  parentGarObjectId  BigInt?                               @map("parent_gar_object_id")
  slug               String                                @unique @map("slug")
  coordinates        Unsupported("geometry(Point, 4326)")? @map("coordinates")
  metadata           Json?                                 @map("metadata")

  name         String  @map("name")
  descriptions String? @map("descriptions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country          Country           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region           Region            @relation(fields: [regionId], references: [id], onDelete: Cascade)
  locality         Locality?         @relation(fields: [localityId], references: [id], onDelete: SetNull)
  localityDistrict LocalityDistrict? @relation(fields: [localityDistrictId], references: [id], onDelete: SetNull)
  settlement       Settlement?       @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  landPlots        LandPlot[]
  buildings        Building[]
  addresses        Address[]

  @@index([countryId])
  @@index([regionId])
  @@index([localityId])
  @@index([localityDistrictId])
  @@index([settlementId])
  @@index([parentGarObjectId])
  @@index([name])
  @@index([coordinates], type: Gist)
  @@map("Streets")
}
