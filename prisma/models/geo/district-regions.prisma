model DistrictRegion {
  id                     String                                @id @default(uuid())
  countryId              String?                               @map("country_id")
  regionId               String                                @map("region_id")
  garObjectId            BigInt?                               @unique @map("gar_object_id")
  garObjectGuid          String?                               @unique @map("gar_object_guid")
  garLevel               Int?                                  @map("gar_level")
  garTypeName            String?                               @map("gar_type_name")
  parentGarObjectId      BigInt?                               @map("parent_gar_object_id")
  slug                   String                                @unique @map("slug")
  coordinates            Unsupported("geometry(Point, 4326)")? @map("coordinates")
  isPurchasedFromTourgis Boolean                               @default(false) @map("is_purchased_from_tourgis")
  metadata               Json?                                 @map("metadata")

  name         String  @map("name")
  descriptions String? @map("descriptions")

  metaTitle        String? @map("meta_title")
  metaDescriptions String? @map("meta_descriptions")
  metaKeywords     String? @map("meta_keywords")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country     Country?     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region      Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  settlements Settlement[]
  addresses   Address[]

  @@unique([regionId, name])
  @@index([parentGarObjectId])
  @@index([countryId])
  @@index([regionId])
  @@index([slug])
  @@index([coordinates], type: Gist)
  @@index([name])
  @@map("DistrictRegions")
}
