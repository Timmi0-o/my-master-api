model Region {
  id                String                                @id @default(uuid())
  code              String?                               @map("code")
  countryId         String                                @map("country_id")
  garObjectId       BigInt?                               @unique @map("gar_object_id")
  garObjectGuid     String?                               @unique @map("gar_object_guid")
  garLevel          Int?                                  @map("gar_level")
  garTypeName       String?                               @map("gar_type_name")
  parentGarObjectId BigInt?                               @map("parent_gar_object_id")
  slug              String                                @unique @map("slug")
  coordinates       Unsupported("geometry(Point, 4326)")? @map("coordinates")
  metadata          Json?                                 @map("metadata")

  name         String  @map("name")
  descriptions String? @map("descriptions")

  metaTitle        String? @map("meta_title")
  metaDescriptions String? @map("meta_descriptions")
  metaKeywords     String? @map("meta_keywords")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  localities        Locality[]
  districtRegions   DistrictRegion[]
  localityDistricts LocalityDistrict[]
  settlements       Settlement[]
  streets           Street[]
  landPlots         LandPlot[]
  buildings         Building[]
  addresses         Address[]

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, name])
  @@index([parentGarObjectId])
  @@index([countryId])
  @@index([slug])
  @@index([coordinates], type: Gist)
  @@index([name])
  @@map("Regions")
}
