model Settlement {
  id                String                                @id @default(uuid())
  countryId         String                                @map("country_id")
  regionId          String                                @map("region_id")
  districtRegionId  String?                               @map("district_region_id")
  garObjectId       BigInt                                @unique @map("gar_object_id")
  garObjectGuid     String                                @unique @map("gar_object_guid")
  garLevel          Int                                   @map("gar_level")
  garTypeName       String?                               @map("gar_type_name")
  parentGarObjectId BigInt?                               @map("parent_gar_object_id")
  slug              String                                @unique @map("slug")
  coordinates       Unsupported("geometry(Point, 4326)")? @map("coordinates")
  metadata          Json?                                 @map("metadata")

  name         String  @map("name")
  descriptions String? @map("descriptions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country        Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region         Region          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  districtRegion DistrictRegion? @relation(fields: [districtRegionId], references: [id], onDelete: SetNull)
  streets        Street[]

  @@index([countryId])
  @@index([regionId])
  @@index([districtRegionId])
  @@index([parentGarObjectId])
  @@index([name])
  @@index([coordinates], type: Gist)
  @@map("Settlements")
}
