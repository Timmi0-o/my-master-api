model Building {
  id                String                                @id @default(uuid())
  countryId         String                                @map("country_id")
  regionId          String                                @map("region_id")
  localityId        String?                               @map("locality_id")
  streetId          String?                               @map("street_id")
  landPlotId        String?                               @map("land_plot_id")
  garObjectId       BigInt                                @unique @map("gar_object_id")
  garObjectGuid     String                                @unique @map("gar_object_guid")
  garHouseId        BigInt?                               @unique @map("gar_house_id")
  garLevel          Int                                   @map("gar_level")
  garTypeName       String?                               @map("gar_type_name")
  parentGarObjectId BigInt?                               @map("parent_gar_object_id")
  slug              String                                @unique @map("slug")
  coordinates       Unsupported("geometry(Point, 4326)")? @map("coordinates")
  metadata          Json?                                 @map("metadata")

  name         String  @map("name")
  houseNum     String? @map("house_num")
  addNum1      String? @map("add_num1")
  addNum2      String? @map("add_num2")
  postalCode   String? @map("postal_code")
  descriptions String? @map("descriptions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country    Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region     Region      @relation(fields: [regionId], references: [id], onDelete: Cascade)
  locality   Locality?   @relation(fields: [localityId], references: [id], onDelete: SetNull)
  street     Street?     @relation(fields: [streetId], references: [id], onDelete: SetNull)
  landPlot   LandPlot?   @relation(fields: [landPlotId], references: [id], onDelete: SetNull)
  apartments Apartment[]
  addresses  Address[]

  @@index([countryId])
  @@index([regionId])
  @@index([localityId])
  @@index([streetId])
  @@index([landPlotId])
  @@index([parentGarObjectId])
  @@index([name])
  @@index([coordinates], type: Gist)
  @@map("Buildings")
}
