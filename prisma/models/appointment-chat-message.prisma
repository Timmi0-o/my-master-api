model AppointmentChatMessage {
  id String @id @default(uuid())

  chatId       String                       @map("chat_id")
  senderUserId String?                      @map("sender_user_id")
  actor        AppointmentChatMessageActor  @default(USER) @map("actor")
  /// USER/SUPPORT: message text. SYSTEM: null (clients render via systemAction + payload).
  body         String?                      @map("body")
  systemAction AppointmentChatSystemAction? @map("system_action")
  payload      Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  chat   AppointmentChat @relation(fields: [chatId], references: [id])
  sender User?           @relation("AppointmentChatMessages", fields: [senderUserId], references: [id])

  @@index([chatId, createdAt])
  @@index([senderUserId])
  @@map("AppointmentChatMessages")
}

enum AppointmentChatMessageActor {
  USER
  SYSTEM
  SUPPORT
}

enum AppointmentChatSystemAction {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
}
