model AppointmentChatMessage {
  id String @id @default(uuid())

  chatId       String                       @map("chat_id")
  senderUserId String?                      @map("sender_user_id")
  actor        AppointmentChatMessageActor  @default(USER) @map("actor")
  /// USER/SUPPORT: message text. SYSTEM: null (clients render via systemAction + payload).
  body         String?                      @map("body")
  systemAction AppointmentChatSystemAction? @map("system_action")
  payload      Json?

  editedAt          DateTime? @map("edited_at")
  editedHistory     String[]  @default([]) @map("edited_history")
  deletedForUserIds String[]  @default([]) @map("deleted_for_user_ids")

  replyToMessageId String? @map("reply_to_message_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  chat             AppointmentChat                      @relation(fields: [chatId], references: [id])
  sender           User?                                @relation("AppointmentChatMessages", fields: [senderUserId], references: [id])
  attachments      AppointmentChatMessageAttachment[]
  replyToMessage   AppointmentChatMessage?              @relation("AppointmentChatMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          AppointmentChatMessage[]             @relation("AppointmentChatMessageReplies")

  @@index([chatId, createdAt])
  @@index([senderUserId])
  @@index([replyToMessageId])
  @@map("AppointmentChatMessages")
}

enum AppointmentChatMessageActor {
  USER
  SYSTEM
  SUPPORT
}

enum AppointmentChatSystemAction {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  APPOINTMENT_RESCHEDULED
}
