/// Состояние напоминаний о непрочитанных сообщениях в appointment-чате.
/// Уникальность: один получатель (userId профиля) на чат.
model AppointmentChatUnreadReminder {
  id String @id @default(uuid())

  chatId                 String @map("chat_id")
  recipientProfileUserId String @map("recipient_profile_user_id")

  remindersCount Int       @default(0) @map("reminders_count")
  lastRemindedAt DateTime? @map("last_reminded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chat      AppointmentChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  recipient User            @relation("AppointmentChatUnreadReminders", fields: [recipientProfileUserId], references: [id], onDelete: Cascade)

  @@unique([chatId, recipientProfileUserId])
  @@index([createdAt])
  @@index([recipientProfileUserId])
  @@map("AppointmentChatUnreadReminders")
}
