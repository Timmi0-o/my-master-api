// Чат мастер↔клиент: 1 пара → 1 чат; appointments — N:1
model AppointmentChat {
  id String @id @default(uuid())

  masterProfileId String @map("master_profile_id")
  clientUserId    String @map("client_user_id")

  /// Курсор прочтения клиента (до какого createdAt входящие USER считаются прочитанными)
  clientLastReadAt DateTime? @map("client_last_read_at")
  /// Курсор прочтения мастера
  masterLastReadAt DateTime? @map("master_last_read_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  masterProfile MasterProfile            @relation(fields: [masterProfileId], references: [id])
  clientUser    User                     @relation("ClientAppointmentChats", fields: [clientUserId], references: [id])
  appointments  Appointment[]
  messages      AppointmentChatMessage[]

  @@unique([masterProfileId, clientUserId])
  @@index([clientUserId])
  @@map("AppointmentChats")
}
