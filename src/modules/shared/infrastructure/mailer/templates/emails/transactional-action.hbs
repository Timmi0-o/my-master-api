<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
  <tr>
    <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;letter-spacing:-0.03em;line-height:1.25;color:#1e293b;padding:0 0 12px 0;">
      {{title}}
    </td>
  </tr>
  <tr>
    <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#64748b;padding:0 0 28px 0;">
      {{intro}}
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 28px 0;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td align="center" bgcolor="#18181b" style="border-radius:999px;background-color:#18181b;">
            <a
              href="{{actionUrl}}"
              target="_blank"
              style="display:inline-block;padding:14px 28px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;line-height:1;color:#fafafa;text-decoration:none;border-radius:999px;"
            >
              {{cta}}
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#94a3b8;padding:0 0 8px 0;">
      {{expires}}
    </td>
  </tr>
  <tr>
    <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#94a3b8;padding:0 0 24px 0;">
      {{ignore}}
    </td>
  </tr>
  <tr>
    <td style="border-top:1px solid rgba(24,24,27,0.08);padding:20px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#94a3b8;">
      <div style="margin:0 0 8px 0;">{{linkFallback}}</div>
      <a href="{{actionUrl}}" target="_blank" style="color:#64748b;word-break:break-all;text-decoration:underline;">{{actionUrl}}</a>
    </td>
  </tr>
</table>
